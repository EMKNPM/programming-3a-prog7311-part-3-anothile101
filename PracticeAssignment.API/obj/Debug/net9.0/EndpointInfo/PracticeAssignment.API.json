  "components": {
    "schemas": {
      "Client": {
        "required": [
          "contactDetails",
          "name",
          "region"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string"
          },
          "contactDetails": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string"
          },
          "region": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "contracts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Contract"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Contract": {
        "required": [
          "clientId",
          "endDate",
          "serviceLevel",
          "startDate",
          "status"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "clientId": {
            "type": "integer",
            "format": "int32"
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "$ref": "#/components/schemas/ContractStatus"
          },
          "serviceLevel": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string"
          },
          "signedAgreementPath": {
            "type": "string",
            "nullable": true
          },
          "signedAgreementFileName": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "client": {
            "$ref": "#/components/schemas/Client"
          },
          "serviceRequests": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServiceRequest"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ContractStatus": {
        "enum": [
          0,
          1,
          2,
          3
        ],
        "type": "integer",
        "format": "int32"
      },
      "ConvertRequest": {
        "type": "object",
        "properties": {
          "usdAmount": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "CreateContractRequest": {
        "type": "object",
        "properties": {
          "clientId": {
            "type": "integer",
            "format": "int32"
          },
          "startDate": {
            "type": "string",
            "format": "date-time"
          },
          "endDate": {
            "type": "string",
            "format": "date-time"
          },
          "serviceLevel": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateServiceRequest": {
        "type": "object",
        "properties": {
          "contractId": {
            "type": "integer",
            "format": "int32"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "costUsd": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ServiceRequest": {
        "required": [
          "contractId",
          "costUsd",
          "description",
          "status"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "contractId": {
            "type": "integer",
            "format": "int32"
          },
          "description": {
            "maxLength": 1000,
            "minLength": 0,
            "type": "string"
          },
          "costUsd": {
            "minimum": 0,01,
            "type": "number",
            "format": "double"
          },
          "costZar": {
            "type": "number",
            "format": "double"
          },
          "exchangeRateUsed": {
            "type": "number",
            "format": "double"
          },
          "status": {
            "$ref": "#/components/schemas/ServiceRequestStatus"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "contract": {
            "$ref": "#/components/schemas/Contract"
          }
        },
        "additionalProperties": false
      },
      "ServiceRequestStatus": {
        "enum": [
          0,
          1,
          2,
          3
        ],
        "type": "integer",
        "format": "int32"
      },
      "UpdateServiceRequestStatus": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/ServiceRequestStatus"
          }
        },
        "additionalProperties": false
      },
      "UpdateStatusRequest": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/ContractStatus"
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "apiKey",
        "description": "Enter 'Bearer' [space] and then your token",
        "name": "Authorization",
        "in": "header"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
}